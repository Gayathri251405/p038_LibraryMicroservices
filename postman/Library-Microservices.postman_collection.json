    {
      "name": "Load balancing - record instance (run collection 20 times)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Book response is served by a registered instance', function () {",
              "  pm.response.to.have.status(200);",
              "  const instance = pm.response.headers.get('X-Service-Instance');",
              "  pm.expect(instance).to.be.oneOf(['8082', '8083']);",
              "  const ports = JSON.parse(pm.collectionVariables.get('instancePorts') || '[]');",
              "  if (!ports.includes(instance)) ports.push(instance);",
              "  pm.collectionVariables.set('instancePorts', JSON.stringify(ports));",
              "  if (pm.info.iteration === pm.info.iterationCount - 1) {",
              "    pm.expect(ports).to.include('8082');",
              "    pm.expect(ports).to.include('8083');",
              "  }",
              "});"
            ]
          }
        }
      ],
